#!/usr/bin/env bash
set -euo pipefail
[[ $EUID == 0 && $# == 2 ]] || { echo 'Usage: sudo qemu-register-ssh-key USER PUBLIC_KEY_FILE (or - for stdin)' >&2; exit 2; }
user=$1
uid=$(id -u -- "$user")
((uid >= 1000 && uid < 65534)) || { echo 'Choose a regular non-root user' >&2; exit 2; }
home_dir=$(getent passwd "$user" | cut -d: -f6)
[[ -d $home_dir && ! -L $home_dir && ! -L $home_dir/.ssh ]] || { echo 'Unsafe or missing home/.ssh' >&2; exit 1; }
umask 077
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
if [[ $2 == - ]]; then cat > "$tmp"; else cat -- "$2" > "$tmp"; fi
# Accept one plain public key, not private keys or authorized_keys directives.
[[ $(awk 'NF && $1 !~ /^#/ {n++} END {print n+0}' "$tmp") == 1 ]] || { echo 'Supply exactly one public key' >&2; exit 2; }
awk 'NF {if ($1 !~ /^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh.com|sk-ecdsa-sha2-nistp256@openssh.com)$/) exit 1}' "$tmp"
ssh-keygen -l -f "$tmp" >/dev/null
install -d -m 0700 -o "$uid" -g "$(id -g "$user")" "$home_dir/.ssh"
auth=$home_dir/.ssh/authorized_keys
[[ ! -L $auth ]] || { echo 'Refusing authorized_keys symlink' >&2; exit 1; }
touch "$auth"
key=$(cat "$tmp")
grep -Fqx -- "$key" "$auth" || printf '%s\n' "$key" >> "$auth"
chmod 0600 "$auth"
chown "$uid:$(id -g "$user")" "$auth"
echo "Public key registered for $user; root SSH and password authentication remain disabled."
