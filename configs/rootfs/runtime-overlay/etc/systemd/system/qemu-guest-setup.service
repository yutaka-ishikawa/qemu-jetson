[Unit]
Description=Explicit QEMU initial setup root console
ConditionKernelCommandLine=qemu.setup=1
After=local-fs.target systemd-networkd.service
Conflicts=serial-getty@ttyAMA0.service
[Service]
Type=simple
KillSignal=SIGHUP
TimeoutStopSec=5
ExecStart=/bin/bash --login
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyAMA0
TTYReset=yes
TTYVHangup=yes
[Install]
WantedBy=multi-user.target
