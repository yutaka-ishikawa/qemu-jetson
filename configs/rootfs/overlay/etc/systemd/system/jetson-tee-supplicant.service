[Unit]
Description=OP-TEE supplicant before udev probes the fTPM driver
DefaultDependencies=no
After=systemd-remount-fs.service
Before=systemd-udev-trigger.service

[Service]
Type=simple
ExecStartPre=/usr/bin/install -d -m 0700 /data/tee
ExecStart=/usr/sbin/tee-supplicant -f /data/tee -l /lib/optee_armtz
Restart=on-failure
RestartSec=2

[Install]
WantedBy=sysinit.target
